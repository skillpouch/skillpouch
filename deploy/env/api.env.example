# SPDX-License-Identifier: AGPL-3.0-only
# API + worker configuration (apps/api/src/config/env.ts documents every variable).
# Secrets are NOT here: they are Docker secrets mounted as *_FILE (see compose.yaml).
NODE_ENV=production
LOG_LEVEL=info
API_PUBLIC_URL=https://skillpouch.net
WEB_ORIGIN=https://skillpouch.net
TRUST_PROXY=true
ADMIN_EMAILS=you@example.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
POLAR_SERVER=production
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
BETTER_AUTH_SECRET_FILE=/run/secrets/better_auth_secret
DPOP_NONCE_SECRET_FILE=/run/secrets/dpop_nonce_secret
IP_HASH_SECRET_FILE=/run/secrets/ip_hash_secret
PEPPER_KEY_FILE=/run/secrets/pepper_key
JWT_SIGNING_KEY_FILE=/run/secrets/jwt_signing_key
CLI_LATEST_VERSION=0.1.0
CLI_MIN_VERSION=0.1.0
