# SPDX-License-Identifier: AGPL-3.0-only
# API + worker configuration (apps/api/src/config/env.ts documents every variable).
# Secrets are NOT here: put each one in deploy/secrets/<name> (e.g. pepper_key);
# it is mounted at /run/secrets and found automatically. Optional secrets
# (github_client_secret, google_client_secret, polar_access_token,
# polar_webhook_secret, s3_secret_access_key) may live there too instead of below.
NODE_ENV=production
LOG_LEVEL=info
API_PUBLIC_URL=https://app.skillpouch.net
WEB_ORIGIN=https://app.skillpouch.net
TRUST_PROXY=true
ADMIN_EMAILS=you@example.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub App for private-repository marketplaces (see EXTERNAL-SERVICES.md)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
POLAR_SERVER=production
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
CLI_MIN_VERSION=0.1.0
# File storage: fs (the blobs volume, default) or s3 (Cloudflare R2, AWS S3,
# MinIO, Garage). Moving an existing server: deploy/README.md → "Moving files to R2".
# With s3, all four S3_ settings below the region are required; the API
# refuses to start without them.
BLOB_DRIVER=fs
# Cloudflare R2: Overview → Account details → S3 API (without the bucket name).
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# S3_BUCKET=skillpouch-blobs
# R2 always uses "auto".
# S3_REGION=auto
# R2 → Manage API tokens → Account API token (Object Read & Write, this bucket).
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional folder inside the bucket, e.g. prod/ to share one bucket.
# S3_PREFIX=
