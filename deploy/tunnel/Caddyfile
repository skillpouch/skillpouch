# Any server behind Cloudflare Tunnel: Cloudflare terminates HTTPS, so
# Caddy serves plain HTTP on 127.0.0.1:80 and only cloudflared reaches it.
# The real client IP arrives in CF-Connecting-IP; it replaces whatever
# X-Forwarded-For the client sent (the API trusts two hops: Caddy + cloudflared).
:80 {
	encode zstd gzip
	header -Server
	request_header X-Forwarded-For {http.request.header.CF-Connecting-IP}

	@api path /v1/* /healthz /readyz /docs*
	handle @api {
		import /etc/caddy/conf.d/upstreams.caddy
	}

	handle {
		root * /srv/web/current
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
