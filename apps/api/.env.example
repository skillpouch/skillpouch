# Local development. Copy to apps/api/.env (git-ignored); `pnpm dev` loads it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/skillpouch
# The browser talks to the API through the Vite dev server (same origin),
# so DPoP proofs name the web origin: both URLs must be the web app's.
API_PUBLIC_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
# Email sign-in form on /sign-in, no OAuth app needed. Never in production.
DEV_LOGIN=true
LOG_LEVEL=info
# Optional: real OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Billing (optional) -----------------------------------------------------
# Polar sandbox: Settings → Developers → New token (organization access token).
# Webhook: Settings → Webhooks → endpoint = <your tunnel URL>/v1/billing/webhooks/polar,
# format Raw, subscription.* events; paste its secret below.
# Then: put your dev email in ADMIN_EMAILS, sign in again, and in the browser
# console run `await __skillpouchDev.syncPlans()` to create the Polar product.
# POLAR_SERVER=sandbox
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# ADMIN_EMAILS=dev@skillpouch.test
