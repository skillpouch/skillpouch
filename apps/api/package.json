{
	"name": "@skillpouch/api",
	"private": true,
	"version": "0.1.0",
	"description": "SkillPouch HTTP API and background worker.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/main.ts",
		"start": "node --enable-source-maps dist/main.mjs",
		"build": "tsdown",
		"openapi": "tsx scripts/openapi.ts",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run",
		"test:unit": "vitest run --project unit"
	},
	"dependencies": {
		"@fastify/cookie": "^11.1.2",
		"@fastify/cors": "^11.3.0",
		"@fastify/helmet": "^13.1.1",
		"@fastify/swagger": "^9.9.1",
		"@fastify/swagger-ui": "^6.1.1",
		"@noble/ciphers": "^2.4.0",
		"@noble/hashes": "^2.4.0",
		"@simplewebauthn/server": "^14.0.3",
		"@skillpouch/contracts": "workspace:*",
		"@skillpouch/db": "workspace:*",
		"better-auth": "^1.7.7",
		"drizzle-orm": "^0.45.3",
		"fastify": "^5.12.5",
		"fastify-plugin": "^6.0.0",
		"fastify-type-provider-zod": "^7.0.0",
		"jose": "^6.2.12",
		"pg": "^8.23.1",
		"pg-boss": "^12.37.0",
		"pino": "^10.4.0",
		"prom-client": "^15.1.3",
		"zod": "^4.6.5"
