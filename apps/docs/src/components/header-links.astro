---
// SPDX-License-Identifier: AGPL-3.0-only
/** The header's link to the site, then the social icons; all open in a new tab. */
import { Icon } from '@astrojs/starlight/components';

const LINKS = [{ href: 'https://skillpouch.net', label: 'Website' }];
const SOCIAL = [
	{ icon: 'github', label: 'SkillPouch on GitHub', href: 'https://github.com/skillpouch' },
	{ icon: 'discord', label: 'Discord', href: 'https://discord.gg/u8eEJZEGhc' },
] as const;
---

<nav aria-label="SkillPouch" class="header-links sl-flex">
	{LINKS.map((link) => (
		<a href={link.href} target="_blank" rel="noopener">
			{link.label}
		</a>
	))}
</nav>
{SOCIAL.map(({ label, href, icon }) => (
	<a href={href} target="_blank" rel="me noopener" class="social sl-flex">
		<span class="sr-only">{label}</span>
		<Icon name={icon} />
	</a>
))}

<style>
	.header-links {
		gap: 1.25rem;
		margin-inline-end: 0.75rem;
		font-size: var(--sl-text-sm);
	}
	.header-links a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.header-links a:hover {
		color: var(--sl-color-white);
	}
	.social {
		color: var(--sl-color-text-accent);
		padding: 0.5em;
		margin: -0.5em;
	}
	.social:hover {
		color: var(--sl-color-white);
	}
	@media (max-width: 72rem) {
		.header-links {
			display: none;
		}
	}
</style>
