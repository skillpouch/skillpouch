---
// SPDX-License-Identifier: AGPL-3.0-only
/** The public home page, served at `/`. */
import AssistantsStrip from '@/components/sections/assistants-strip.astro';
import ClosingCta from '@/components/sections/closing-cta.astro';
import DemoVideo from '@/components/sections/demo-video/demo-video.astro';
import Faq from '@/components/sections/faq.astro';
import FeatureBento from '@/components/sections/feature-bento/feature-bento.astro';
import Hero from '@/components/hero/hero.astro';
import LandingFooter from '@/components/layout/landing-footer.astro';
import LandingNav from '@/components/layout/landing-nav.astro';
import { Pricing } from '@/components/sections/pricing/pricing';
import ProductShot from '@/components/sections/product-shot/product-shot.astro';
import SyncFlow from '@/components/sections/sync-flow/sync-flow.astro';
import Page from '@/layouts/page.astro';
import { buildTimePlans } from '@/lib/plans';
import { organization, softwareApplication, webPage, website } from '@/lib/structured-data';

const title = 'SkillPouch: your AI coding setup, on every computer';
const description =
	'Skills, agents, MCP servers and instructions sync across Claude Code, Codex, Cursor and more. End-to-end encrypted, open source.';
const plans = await buildTimePlans();
const structuredData = [
	organization(),
	website(),
	softwareApplication(description, plans),
	webPage('/', title, description),
];
---

<Page title={title} description={description} structuredData={structuredData}>
	<div class="landing min-h-dvh bg-bg text-fg">
		<LandingNav />
		<main>
			<Hero />
			<AssistantsStrip />
			<DemoVideo />
			<ProductShot />
			<SyncFlow />
			<FeatureBento />
			<Pricing client:idle initialPlans={plans} />
			<Faq />
			<ClosingCta />
		</main>
		<LandingFooter />
	</div>
</Page>
