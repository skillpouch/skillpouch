---
// SPDX-License-Identifier: AGPL-3.0-only
/** A readable page for the Terms and the Privacy Policy, inside the site's nav and footer. */
import ContentPage from '@/components/layout/content-page.astro';

interface Props {
	title: string;
	description: string;
	path: string;
}

const LEGAL_UPDATED = 'October 9, 2026';

const { title, description, path } = Astro.props;
---

<ContentPage title={title} description={description} path={path}>
	<p slot="meta" class="mt-4 text-xs text-meta">
		Last updated {LEGAL_UPDATED}
	</p>
	<slot />
</ContentPage>
