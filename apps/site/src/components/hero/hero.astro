---
// SPDX-License-Identifier: AGPL-3.0-only
import { Code2, Lock, Sparkles } from 'lucide-react';
import { HeroScene } from './hero-beams';
import { InstallCommand } from '@/components/ui/install-command';
import { ButtonLink } from '@/components/ui/button-link';

const PROOF = [
	{ icon: Lock, label: 'End-to-end encrypted' },
	{ icon: Code2, label: 'Open source' },
	{ icon: Sparkles, label: 'Free to start' },
];
---

<section
	id="top"
	class="relative isolate flex min-h-[100dvh] flex-col items-center overflow-hidden px-5"
>
	<!--
	<img
		src={hero.src}
		alt=""
		width={hero.width}
		height={hero.height}
		fetchpriority="high"
		decoding="async"
		class="absolute inset-0 -z-20 size-full object-cover object-bottom"
	/>
    -->
	<HeroScene client:load />
	<div
		aria-hidden="true"
		class="absolute inset-x-0 top-0 -z-10 h-2/3 bg-[radial-gradient(ellipse_at_50%_30%,rgb(0_0_0/0.75),transparent_70%)]"
	></div>
	<div
		aria-hidden="true"
		class="absolute inset-x-0 bottom-0 -z-10 h-32 bg-gradient-to-b from-transparent to-bg"
	></div>

	<div class="landing-rise relative my-auto flex max-w-[980px] flex-col items-center gap-10 py-24 text-center lg:flex-row lg:gap-14 lg:text-left">
		<div
			aria-hidden="true"
			class="absolute inset-x-[-8%] top-[-18%] bottom-[-30%] -z-10 rounded-[50%] bg-black/80 blur-2xl"
		></div>
		<figure class="landing-rise shrink-0" aria-label="The SkillPouch mascot">
			<img
				src={`${import.meta.env.BASE_URL}/tui/mascot.gif`}
				alt="The SkillPouch mascot"
				width={364}
				height={336}
				decoding="async"
				class="block h-auto w-[120px] [image-rendering:pixelated] lg:w-[152px]"
			/>
		</figure>
		<div class="flex flex-col items-center lg:items-start">
			<h1 class="landing-display landing-rise text-[44px] leading-[1.02] font-semibold text-balance text-fg [animation-delay:50ms] sm:text-6xl lg:text-[68px]">
				Your AI coding setup, on every computer.
			</h1>
			<p class="landing-rise mt-6 max-w-[56ch] text-base leading-relaxed text-pretty text-[#b4b4b4] [animation-delay:180ms] sm:text-lg">
				Skills, agents, MCP servers and instructions sync across Claude Code, Codex, Cursor
				and more. End-to-end encrypted.
			</p>
			<div class="landing-rise mt-9 flex flex-col items-center gap-3 [animation-delay:300ms] sm:flex-row">
				<ButtonLink
					href="/sign-in"
					variant="primary"
					size="lg"
					className="h-11 rounded-full px-6 shadow-[0_8px_32px_-8px_var(--landing-glow)] active:scale-[0.98]"
				>
					Get started
				</ButtonLink>
				<InstallCommand client:idle />
			</div>
			<ul
				class="landing-rise mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 [animation-delay:430ms] lg:justify-start"
				aria-label="Why SkillPouch"
			>
				{PROOF.map(({ icon: Icon, label }) => (
					<li class="flex items-center gap-1.5 text-[13px] font-medium text-meta">
						<Icon className="size-3.5 text-accent" aria-hidden="true" />
						{label}
					</li>
				))}
			</ul>
		</div>
	</div>
</section>
