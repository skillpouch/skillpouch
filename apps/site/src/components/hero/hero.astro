---
// SPDX-License-Identifier: AGPL-3.0-only
import hero from '@/assets/landing/hero.webp';
import tuiOverview from '@/assets/landing/tui-overview.webp';
import { Code2, Lock, Sparkles } from 'lucide-react';
import { HeroScene } from './hero-beams';
import { InstallCommand } from '@/components/ui/install-command';
import { ButtonLink } from '@/components/ui/button-link';

const PROOF = [
	{ icon: Lock, label: 'End-to-end encrypted' },
	{ icon: Code2, label: 'Open source' },
	{ icon: Sparkles, label: 'Free to start' },
];
---

<section
	id="top"
	class="relative isolate flex min-h-[100dvh] flex-col items-center overflow-hidden px-5"
>
	<!--
	<img
		src={hero.src}
		alt=""
		width={hero.width}
		height={hero.height}
		fetchpriority="high"
		decoding="async"
		class="absolute inset-0 -z-20 size-full object-cover object-bottom"
	/>
    -->
	<HeroScene client:load />
	<div
		aria-hidden="true"
		class="absolute inset-x-0 top-0 -z-10 h-2/3 bg-[radial-gradient(ellipse_at_50%_30%,rgb(0_0_0/0.75),transparent_70%)]"
	></div>
	<div
		aria-hidden="true"
		class="absolute inset-x-0 bottom-0 -z-10 h-32 bg-gradient-to-b from-transparent to-bg"
	></div>

	<div class="relative flex max-w-[860px] flex-col items-center pt-24 text-center sm:pt-28">
		<div
			aria-hidden="true"
			class="absolute inset-x-[-10%] top-[38%] bottom-[-45%] -z-10 rounded-[50%] bg-black/80 blur-2xl"
		></div>
		<h1 class="landing-display landing-rise text-[44px] leading-[1.02] font-semibold text-balance text-fg [animation-delay:50ms] sm:text-6xl lg:text-[76px]">
			Your AI coding setup, on every computer.
		</h1>
		<p class="landing-rise mt-6 max-w-[56ch] text-base leading-relaxed text-pretty text-[#b4b4b4] [animation-delay:180ms] sm:text-lg">
			Skills, agents, MCP servers and instructions sync across Claude Code, Codex, Cursor and
			more. End-to-end encrypted.
		</p>
		<div class="landing-rise mt-9 flex flex-col items-center gap-3 [animation-delay:300ms] sm:flex-row">
			<ButtonLink
				href="/sign-in"
				variant="primary"
				size="lg"
				className="h-11 rounded-full px-6 shadow-[0_8px_32px_-8px_var(--landing-glow)] active:scale-[0.98]"
			>
				Get started
			</ButtonLink>
			<InstallCommand client:idle />
		</div>
		<ul
			class="landing-rise mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 [animation-delay:430ms]"
			aria-label="Why SkillPouch"
		>
			{PROOF.map(({ icon: Icon, label }) => (
				<li class="flex items-center gap-1.5 text-[13px] font-medium text-meta">
					<Icon className="size-3.5 text-accent" aria-hidden="true" />
					{label}
				</li>
			))}
		</ul>
	</div>

	<div
		class="landing-rise relative mt-auto w-full max-w-[880px] [animation-delay:550ms]"
		style={{ transform: 'translateY(1px)' }}
	>
		<figure class="overflow-hidden rounded-t-2xl border border-b-0 border-white/12 bg-[#08060d] shadow-[inset_0_1px_0_rgb(255_255_255/0.08)]">
			<div class="h-[210px] sm:h-[280px] lg:h-[340px]">
				<img
					src={tuiOverview.src}
					alt="The SkillPouch terminal UI: the pouch mascot, the active pouch, plan meters and daily token usage."
					width={tuiOverview.width}
					height={tuiOverview.height}
					fetchpriority="high"
					decoding="async"
					class="block h-full w-full object-cover object-top"
				/>
			</div>
		</figure>
	</div>
</section>
