---
// SPDX-License-Identifier: AGPL-3.0-only
import { ButtonLink } from '@/components/ui/button-link';
import { SIGN_IN_URL } from '@/lib/links';
import Logo from './logo.astro';
import SocialLinks from './social-links.astro';

// Absolute, so they also work from the Terms and Privacy pages.
const SECTIONS = [
	{ href: '/#how', label: 'How it works' },
	{ href: '/#features', label: 'Features' },
	{ href: '/#pricing', label: 'Pricing' },
	{ href: '/#faq', label: 'FAQ' },
];
---

<header data-landing-nav class="group fixed inset-x-0 top-3 z-40 flex justify-center px-3 sm:top-4">
	<!-- Once the page scrolls, content fades out before it reaches the pill. -->
	<div
		aria-hidden="true"
		class="pointer-events-none absolute inset-x-0 -top-3 h-28 bg-gradient-to-b from-bg from-50% to-transparent opacity-0 transition-opacity duration-300 group-data-scrolled:opacity-100 sm:-top-4"
	></div>
	<nav
		aria-label="Main"
		class="relative flex w-full max-w-[880px] items-center justify-between gap-4 rounded-full border border-white/10 bg-black/60 py-1.5 pr-1.5 pl-4 shadow-[inset_0_1px_0_rgb(255_255_255/0.06)] backdrop-blur-xl transition-colors duration-300 group-data-scrolled:bg-black/85"
	>
		<a href="/#top" aria-label="SkillPouch home" class="shrink-0">
			<Logo size={22} />
		</a>
		<ul class="hidden items-center gap-1 text-[13px] text-muted md:flex">
			{SECTIONS.map((section) => (
				<li>
					<a
						href={section.href}
						class="flex h-7 items-center rounded-full px-3 text-[13px] text-muted transition-colors hover:bg-white/5 hover:text-fg focus-visible:text-fg"
					>
						<span class="trim-to-caps">{section.label}</span>
					</a>
				</li>
			))}
		</ul>
		<div class="flex items-center gap-1">
			<SocialLinks />
			<ButtonLink href={SIGN_IN_URL} variant="primary" className="rounded-full">
				Get started
			</ButtonLink>
		</div>
	</nav>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-landing-nav]');
	if (header) {
		const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
		window.addEventListener('scroll', update, { passive: true });
		update();
	}
</script>
