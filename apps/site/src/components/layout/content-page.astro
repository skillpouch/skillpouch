---
// SPDX-License-Identifier: AGPL-3.0-only
/**
 * A readable text page inside the site's nav and footer: About, Compare, FAQ
 * and the legal pages. Shows the breadcrumb trail it also gives search engines.
 */
import LandingFooter from '@/components/layout/landing-footer.astro';
import LandingNav from '@/components/layout/landing-nav.astro';
import Page from '@/layouts/page.astro';
import { breadcrumbList, webPage } from '@/lib/structured-data';

interface Props {
	/** The page heading; the document title adds "· SkillPouch" unless `documentTitle` is set. */
	title: string;
	documentTitle?: string;
	description: string;
	path: string;
	/** The breadcrumb's name for this page, if shorter than the title. */
	crumb?: string;
	/** schema.org type of the page itself, e.g. `AboutPage`. */
	pageType?: string;
	/** More properties of the page node, e.g. an `FAQPage`'s questions. */
	pageData?: Record<string, unknown>;
	structuredData?: Record<string, unknown>[];
}

const {
	title,
	documentTitle = `${title} · SkillPouch`,
	description,
	path,
	crumb = title,
	pageType = 'WebPage',
	pageData,
	structuredData = [],
} = Astro.props;
const crumbs = [
	{ name: 'Home', path: '/' },
	{ name: crumb, path },
];
---

<Page
	title={documentTitle}
	description={description}
	path={path}
	structuredData={[
		webPage(path, documentTitle, description, pageType, pageData),
		breadcrumbList(crumbs),
		...structuredData,
	]}
>
	<div class="landing flex min-h-dvh flex-col bg-bg text-fg">
		<LandingNav />
		<main class="mx-auto w-full max-w-[720px] flex-1 px-5 pt-32 pb-24 sm:pt-36">
			<nav aria-label="Breadcrumb" class="mb-6 text-xs text-meta">
				<ol class="flex items-center gap-2">
					<li>
						<a href="/" class="hover:text-fg">
							Home
						</a>
					</li>
					<li aria-hidden="true">/</li>
					<li aria-current="page" class="text-muted">
						{crumb}
					</li>
				</ol>
			</nav>
			<h1 class="landing-display text-4xl leading-[1.05] font-semibold sm:text-5xl">
				{title}
			</h1>
			<slot name="meta" />
			<div class="prose-page mt-10 flex flex-col gap-8 text-[15px] leading-relaxed text-muted">
				<slot />
			</div>
		</main>
		<LandingFooter />
	</div>
</Page>

<style>
	.prose-page :global(h2) {
		font-size: 1.125rem;
		font-weight: 500;
		color: var(--color-fg);
	}
	.prose-page :global(h3) {
		font-size: 1rem;
		font-weight: 500;
		color: var(--color-fg);
	}
	.prose-page :global(section) {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.prose-page :global(ul),
	.prose-page :global(ol) {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		padding-left: 1.25rem;
		list-style: disc;
	}
	.prose-page :global(ol) {
		list-style: decimal;
	}
	.prose-page :global(strong) {
		color: var(--color-fg);
		font-weight: 500;
	}
	.prose-page :global(code) {
		font-family: var(--font-mono, ui-monospace, monospace);
		font-size: 0.875em;
		color: var(--color-fg);
		background: var(--color-surface-2);
		border: 1px solid var(--color-border);
		border-radius: 0.375rem;
		padding: 0.05rem 0.35rem;
	}
	.prose-page :global(pre) {
		overflow-x: auto;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 0.5rem;
		padding: 0.875rem 1rem;
	}
	.prose-page :global(pre code) {
		background: none;
		border: 0;
		padding: 0;
	}
	.prose-page :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: 14px;
	}
	.prose-page :global(.table-scroll) {
		overflow-x: auto;
	}
	.prose-page :global(th),
	.prose-page :global(td) {
		border-bottom: 1px solid var(--color-border);
		padding: 0.625rem 0.75rem 0.625rem 0;
		text-align: left;
		vertical-align: top;
	}
	.prose-page :global(th) {
		color: var(--color-fg);
		font-weight: 500;
	}
	.prose-page :global(a) {
		color: var(--color-fg);
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.prose-page :global(a:hover) {
		color: var(--color-accent-text);
	}
</style>
