---
// SPDX-License-Identifier: AGPL-3.0-only
import { CONTACT_EMAIL, SOURCE_URL } from '@/components/landing-content';
import { DOCS_PAGES, DOCS_URL } from '@/lib/links';
import Logo from './logo.astro';
import SocialLinks from './social-links.astro';
---

<footer class="border-t border-border px-5 py-10">
	<div class="mx-auto flex max-w-[1120px] flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
		<div class="flex flex-col gap-2">
			<Logo />
			<p class="text-xs text-meta">
				© {new Date().getFullYear()} SkillPouch. Open source under the AGPL.
			</p>
		</div>
		<nav
			aria-label="Footer"
			class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[13px] text-muted"
		>
			<SocialLinks />
			<a class="hover:text-fg" href="/about/">
				About
			</a>
			<a class="hover:text-fg" href={DOCS_URL}>
				Docs
			</a>
			<a class="hover:text-fg" href="/faq/">
				FAQ
			</a>
			<a class="hover:text-fg" href="/compare/">
				Compare
			</a>
			<a class="hover:text-fg" href={DOCS_PAGES.security}>
				Security
			</a>
			<a class="hover:text-fg" href={DOCS_PAGES.selfHosting}>
				Self-hosting
			</a>
			<a class="hover:text-fg" href={SOURCE_URL}>
				GitHub
			</a>
			<a class="hover:text-fg" href="/terms/">
				Terms
			</a>
			<a class="hover:text-fg" href="/privacy/">
				Privacy
			</a>
			<a class="hover:text-fg" href={`mailto:${CONTACT_EMAIL}`}>
				{CONTACT_EMAIL}
			</a>
		</nav>
	</div>
</footer>
