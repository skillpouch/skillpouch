---
// SPDX-License-Identifier: AGPL-3.0-only
import { AssistantIcon } from '@/components/ui/assistant-icon';
import { ASSISTANTS } from '@/components/landing-content';
import { DOCS_PAGES } from '@/lib/links';
---

<section aria-labelledby="works-with" class="px-5 pt-6 pb-20">
	<h2 id="works-with" class="text-center text-[13px] text-meta">
		Works with the assistants you already use
	</h2>
	<ul class="mx-auto mt-6 flex max-w-[1240px] flex-wrap justify-center gap-x-7 gap-y-4">
		{ASSISTANTS.map((assistant) => (
			<li class="flex items-center gap-2 text-[15px] font-medium text-muted transition-colors hover:text-fg">
				<AssistantIcon id={assistant.id} className="size-5" />
				{assistant.name}
			</li>
		))}
	</ul>
	<p class="mt-6 text-center text-[13px] text-meta">
		<a
			class="text-fg underline underline-offset-4 hover:text-accent-text"
			href={DOCS_PAGES.assistants}
		>
			See what syncs where
		</a>
	</p>
</section>
