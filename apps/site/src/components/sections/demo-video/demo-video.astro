---
// SPDX-License-Identifier: AGPL-3.0-only
/** The 30-second promo, played on request with sound. */
import { DEMO_VIDEO } from './demo-video';
---

<section id="demo" aria-labelledby="demo-title" class="px-5 pb-28">
	<div class="mx-auto max-w-[1120px]">
		<h2
			id="demo-title"
			class="landing-display text-center text-4xl leading-[1.05] font-semibold text-balance sm:text-5xl"
		>
			See it in 30 seconds.
		</h2>
		<div class="relative mt-12">
			<div
				aria-hidden="true"
				class="absolute inset-x-[10%] top-[15%] bottom-[-5%] -z-10 rounded-[50%] bg-accent/35 blur-[110px]"
			></div>
			<video
				src={DEMO_VIDEO.src}
				poster={DEMO_VIDEO.poster}
				width={DEMO_VIDEO.width}
				height={DEMO_VIDEO.height}
				controls
				playsinline
				preload="none"
				aria-label="SkillPouch promo video"
				class="block h-auto w-full rounded-xl border border-white/12 bg-black shadow-[0_40px_120px_-30px_rgb(132_66_217/0.55)]"
			></video>
		</div>
	</div>
</section>
