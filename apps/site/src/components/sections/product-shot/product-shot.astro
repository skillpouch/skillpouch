---
// SPDX-License-Identifier: AGPL-3.0-only
/** The web app's file editor in a browser frame; it straightens as it scrolls in. */
import editor from '@/assets/landing/editor.webp';
---

<section aria-labelledby="editor-title" class="px-5 pb-28">
	<div class="mx-auto max-w-[1200px]">
		<div class="mx-auto max-w-[720px] text-center">
			<h2
				id="editor-title"
				class="landing-display text-4xl leading-[1.05] font-semibold text-balance sm:text-5xl"
			>
				Everything your assistants know, in one place.
			</h2>
			<p class="mx-auto mt-5 max-w-[58ch] text-base leading-relaxed text-muted">
				Browse every file of every skill, edit with syntax highlighting, or share one with a
				link. Saved changes reach your computers in the background.
			</p>
		</div>

		<div data-product-shot class="relative mt-14 [perspective:1800px]">
			<div
				aria-hidden="true"
				data-glow
				style="opacity: 0.25"
				class="absolute inset-x-[8%] top-[18%] bottom-[-6%] -z-10 rounded-[50%] bg-accent/45 blur-[110px]"
			></div>
			<figure
				data-frame
				style="transform: scale(0.92) rotateX(22deg); transform-origin: 50% 0%"
				class="overflow-hidden rounded-xl border border-white/12 bg-surface shadow-[0_40px_120px_-30px_rgb(132_66_217/0.55),inset_0_1px_0_rgb(255_255_255/0.08)]"
			>
				<div class="flex h-9 items-center gap-2 border-b border-border px-4">
					<span class="size-2.5 rounded-full bg-white/12"></span>
					<span class="size-2.5 rounded-full bg-white/12"></span>
					<span class="size-2.5 rounded-full bg-white/12"></span>
					<span class="mx-auto rounded-md bg-white/5 px-10 py-1 font-mono text-[11px] text-meta">
						app.skillpouch.net
					</span>
				</div>
				<img
					src={editor.src}
					alt="The SkillPouch web app showing the pdf skill: a file tree on the left and SKILL.md open with syntax highlighting."
					width={2400}
					height={1500}
					loading="lazy"
					decoding="async"
					class="block h-auto w-full"
				/>
			</figure>
		</div>
	</div>
</section>

<script>
	import { shotProgress } from './product-shot';

	const shot = document.querySelector<HTMLElement>('[data-product-shot]');
	const frame = shot?.querySelector<HTMLElement>('[data-frame]');
	const glow = shot?.querySelector<HTMLElement>('[data-glow]');
	if (shot && frame && glow) {
		const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let queued = false;
		const update = () => {
			queued = false;
			const progress = shotProgress(shot.getBoundingClientRect().top, window.innerHeight);
			const rotate = still ? 0 : 22 * (1 - progress);
			const scale = still ? 1 : 0.92 + 0.08 * progress;
			frame.style.transform = `scale(${scale}) rotateX(${rotate}deg)`;
			glow.style.opacity = String(0.25 + 0.55 * progress);
		};
		const queue = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(update);
		};
		window.addEventListener('scroll', queue, { passive: true });
		window.addEventListener('resize', queue);
		update();
	}
</script>
