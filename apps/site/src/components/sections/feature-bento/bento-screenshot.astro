---
// SPDX-License-Identifier: AGPL-3.0-only
/** A crop of an app screenshot past its sidebar, bleeding off the cell's corner. */
import type { ImageMetadata } from 'astro';
import { cn } from '@/lib/cn';

interface Props {
	image: ImageMetadata;
	alt: string;
	class: string;
}

const { image, alt, class: className } = Astro.props;
---

<div class="relative -mr-6 -mb-6 h-full min-h-[260px] overflow-hidden rounded-tl-lg border-t border-l border-border-strong [mask-image:linear-gradient(to_bottom,black_55%,transparent)]">
	<img
		src={image.src}
		alt={alt}
		width={1800}
		height={1125}
		loading="lazy"
		decoding="async"
		class={cn('absolute top-[-3%] w-[165%] max-w-none', className)}
	/>
</div>
